@article{kundu2026ednet,
  title       = {ED-Net: A Hybrid Deep Learning Framework for Precise Polyp Segmentation Integrating {EfficientNetB0} with Double {U-Net} Architecture and Atrous Spatial Pyramid Pooling with Test-Time Augmentation},
  author      = {Kundu, Rahul Kumar and Kibria, Hafsa Binte and Ahamed, Md Faysal and Chowdhury, Muhammad EH},
  journal     = {Biomedical Signal Processing and Control},
  volume      = {123},
  pages       = {110566},
  year        = {2026},
  issn        = {1746-8094},
  publisher   = {Elsevier},
  doi         = {10.1016/j.bspc.2026.110566},
  html        = {https://www.sciencedirect.com/science/article/pii/S1746809426011201},
  abbr        = {BSPC},
  bibtex_show = {true},
  selected    = {true},
  keyword     = {journal},
  abstract    = {Colorectal cancer (CRC) is a major global health concern, and colorectal polyps are early indicators of CRC. This study introduces ED-Net, a deep-learning-based segmentation framework incorporating a pretrained EfficientNetB0 encoder within a dual encoder-decoder architecture enhanced by ASPP and SE blocks. ED-Net with TTA achieved 97.13% accuracy, 92.26% Dice, and 91.08% IoU on Kvasir-SEG, substantially outperforming SOTA models.},
}

